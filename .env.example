
# Server listen address
ADDR=:2759

# Should the server serve the web frontend? Set to false in production.
DEV_MODE=false

# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hemkopdle
DB_USER=hemkopdle
DB_PASSWORD=change-me

# Scrap cron schedule (Monday 06:00 local time by default). Scheduled scrapes
# only run inside hemkop.se's visit time, 04:00-08:45 UTC.
SCRAPE_CRON_SCHED=0 6 * * 1

# Scrape at startup when the products table is empty.
SCRAPE_ON_START=true

# hemkop.se/robots.txt asks for Crawl-delay: 10
SCRAPE_DELAY=10s

# Leave empty to auto-detect Chromium/Chrome.
CHROME_PATH=
